# .env.example
# Copy this file to .env and fill only the values required locally.

# Provider settings
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOCAL_LLM_BASE_URL=

# Optional runtime settings
QUANTUM_AGENT_LOG_LEVEL=INFO
QUANTUM_AGENT_DATA_DIR=.quantum-agent
QUANTUM_AGENT_APPROVAL_MODE=interactive
QUANTUM_AGENT_MAX_SHOTS=1024
QUANTUM_AGENT_MAX_TOOL_CALLS=12
QUANTUM_AGENT_MAX_ITERATIONS=10

# Quantum configuration
QUANTUM_BACKEND=mock
QUANTUM_SEED=1234

# Provider model selection
DEFAULT_LLM_PROVIDER=mock
DEFAULT_MODEL_ID=mock-model
